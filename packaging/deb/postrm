#!/bin/sh
# manta's postrm (MAN-540): debhelper 13.14 postrm-systemd-reload-only and
# postrm-systemd, plus deleting the config the postinst created.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = "purge" ]; then
	rm -f "${DPKG_ROOT:-}/etc/manta/manta.toml" "${DPKG_ROOT:-}/etc/manta/manta.toml.dpkg-tmp"
	rmdir "${DPKG_ROOT:-}/etc/manta" 2>/dev/null || true
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'manta.service' >/dev/null || true
	fi
fi
